# ---- force HTTPS ----
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ---- www -> non-www ----
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

# ---- legacy per-product privacy policy now lives on the unified page ----
RewriteRule ^privacy-policy-sipnex/?$ /privacy-policy#sipnex [R=301,L]

# ---- clean URLs: /products serves /products/index.html ----
DirectoryIndex index.html

# ---- legacy .html requests redirect to the clean URL ----
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# ---- empty blog placeholders from the old dibsen.io site: send them home
#      instead of letting Google's indexed links dead-end on a 404 ----
RewriteRule ^blog-post[0-9]*/?$ / [R=301,L]

ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript text/javascript image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp    "access plus 1 year"
  ExpiresByType image/png     "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css        "access plus 1 day"
  ExpiresByType text/javascript "access plus 1 day"
  ExpiresByType video/mp4       "access plus 1 year"
  ExpiresByType image/jpeg      "access plus 1 year"
  # HTML is NOT cached. Assets are versioned (?v=), so they can be held for a
  # year safely — but a cached page would keep serving the old asset URLs and
  # every update would look like it never happened.
  ExpiresByType text/html     "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Belt and braces: make the no-cache explicit for pages, so proxies and
  # LiteSpeed's own cache revalidate too, not just the browser.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
  </FilesMatch>
</IfModule>
